{
    "name": "alcor/earning-line-history",
    "description": "Earning line state with immutable system and manual adjustment history",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "ext-bcmath": "*",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*",
        "moneyphp/money": "^4.0",
        "nesbot/carbon": "^3.0",
        "ramsey/uuid": "^4.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {"App\\": "src/"}
    },
    "autoload-dev": {
        "psr-4": {"App\\Tests\\": "tests/"}
    },
    "config": {
        "sort-packages": true,
        "platform": {"php": "8.4.0"}
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite Unit",
        "test:integration": "phpunit --testsuite Integration",
        "test:acceptance": "phpunit --testsuite Acceptance",
        "demo": "php bin/demo.php",
        "lint": "find src bin tests -name '*.php' -print0 | xargs -0 -n1 php -l"
    }
}
