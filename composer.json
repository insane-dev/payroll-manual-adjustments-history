{
    "name": "alcor/earning-line-history",
    "description": "Event-sourced earning lines with immutable manual adjustment history",
    "type": "project",
    "require": {
        "php": "^8.4",
        "ext-bcmath": "*",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*",
        "moneyphp/money": "^4.0",
        "nesbot/carbon": "^3.0",
        "ramsey/uuid": "^4.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {"Alcor\\Payroll\\": "src/"}
    },
    "autoload-dev": {
        "psr-4": {"Alcor\\Payroll\\Tests\\": "tests/"}
    },
    "config": {
        "sort-packages": true,
        "platform": {"php": "8.4.0"}
    },
    "scripts": {
        "test": "phpunit",
        "demo": "php bin/demo.php"
    }
}
